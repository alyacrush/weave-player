{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "weave-player@alyacrush",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "personallyIdentifyingInfo",
          "websiteContent"
        ]
      }
    }
  },
  "name": "Weave Player for Twitch",
  "short_name": "Weave",
  "version": "2026.11.22.1",
  "description": "__MSG_M0001__",
  "icons": {
    "16": "manifest-small.svg",
    "32": "manifest-small.svg",
    "128": "manifest.svg"
  },
  "author": "alyacrush",
  "default_locale": "en",
  "permissions": [
    "storage",
    "cookies",
    "webRequest",
    "webRequestBlocking",
    "clipboardWrite",
    "https://*.twitch.tv/*",
    "https://*.twitchcdn.net/*",
    "https://*.ttvnw.net/*",
    "https://*.jtvnw.net/*",
    "https://*.live-video.net/*",
    "https://*.akamaized.net/*",
    "https://*.cloudfront.net/*"
  ],
  "web_accessible_resources": [
    "content.css",
    "player.html"
  ],
  "background": {
    "persistent": true,
    "scripts": [
      "quality-proxy.js",
      "quality-proxy-background.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://m.twitch.tv/*"
      ],
      "exclude_matches": [
        "https://www.twitch.tv/popout/"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "autoclaim.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "proxy"
  ]
}
